{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content user forgot password">
	<div class="ui middle very relaxed page grid">
		<div class="column">
			<form class="ui form ignore-dirty" action="{{.Link}}" method="post">
				{{.CsrfTokenHtml}}
				<h2 class="ui top attached header">
					{{ctx.Locale.Tr "auth.forgot_password_title"}}
				</h2>
				<div class="ui attached segment">
					{{template "base/alert" .}}
					{{if .IsResetSent}}
						<p>{{ctx.Locale.Tr "auth.reset_password_mail_sent_prompt" .Email .ResetPwdCodeLives}}</p>
					{{else if .IsResetRequest}}
						<div class="required field {{if .Err_Email}}error{{end}}">
							<label for="email">{{ctx.Locale.Tr "email"}}</label>
							<input id="email" name="email" type="email"  value="{{.Email}}" autofocus required>
						</div>
						<div class="divider"></div>
						<div class="inline field">
							<button class="ui primary button">{{ctx.Locale.Tr "auth.send_reset_mail"}}</button>
						</div>
					{{else if .IsResetDisable}}
						<p class="center">
						{{ctx.Locale.Tr "auth.disable_forgot_password_mail_contact_email_1"}}
						<a class="tw-flex-1" href="mailto:{{ctx.Locale.Tr "auth.disable_forgot_password_mail_default_contact"}}" rel="nofollow">{{ctx.Locale.Tr "auth.disable_forgot_password_mail_default_contact"}}</a>
						{{ctx.Locale.Tr "auth.disable_forgot_password_mail_contact_email_2"}}
						</p>
						<p class="center"> {{ctx.Locale.Tr "auth.disable_forgot_password_mail_contact"}}</p>
						<p class="center"> {{ctx.Locale.Tr "auth.disable_forgot_password_mail_contact_support_time_title"}} {{ctx.Locale.Tr "auth.disable_forgot_password_mail_contact_support_time_1"}} / {{ctx.Locale.Tr "auth.disable_forgot_password_mail_contact_support_time_2"}} {{ctx.Locale.Tr "auth.disable_forgot_password_mail_contact_time_zone"}}</p>
					{{else if .ResendLimited}}
						<p class="center">{{ctx.Locale.Tr "auth.resent_limit_prompt"}}</p>
					{{end}}
				</div>
			</form>
		</div>
	</div>
</div>
{{template "base/footer" .}}
